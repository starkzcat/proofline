PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proofline"
JWT_SECRET="replace-with-32-char-secret"
CORS_ORIGIN="http://localhost:5173"
ENABLE_DEMO_MODE="true"

# S3 / Cloudflare R2
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="proofline-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://pub-<id>.r2.dev"
